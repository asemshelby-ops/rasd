# Copy this file to a new file named .env and put the real key after the = sign.
# .env is ignored by git, so the key never reaches GitHub. Never commit a key.
RASD_CLAUDE_KEY=
# Optional: the key of the speech-to-text service, for live voice notes. Without it the saved voice notes still work.
RASD_OPENAI_KEY=
# The PIN of the operator page and the supervisor page. Choose 4 digits or more. If left empty, a random one is printed when the site starts.
RASD_PIN=
